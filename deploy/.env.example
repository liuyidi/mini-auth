# Copy to /opt/auth/.env on the server (do not commit real secrets).

POSTGRES_USER=auth
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=mini_auth
DATABASE_URL=postgresql://auth:change-me-strong-password@db:5432/mini_auth

REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=30
JWT_ISSUER=https://auth.liuyidi.me
AUTH_ADMIN_API_KEY=change-me-admin-api-key

# Daily digest → Feishu (Umami Cloud share; no Pro API key)
# Prefer FEISHU_WEBHOOK_URL, or Feishu app IM credentials (same as serverless-ship).
FEISHU_WEBHOOK_URL=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TARGET_OPEN_ID=
FEISHU_TARGET_ID_TYPE=open_id
UMAMI_SHARE_BASE_URL=https://cloud.umami.is/analytics/us
UMAMI_SHARE_SLUG=fAjwSKOBPqy37HAd
DIGEST_TIMEZONE=Asia/Shanghai

CORS_ORIGINS=https://bot.liuyidi.me,https://auth.liuyidi.me,https://kb.liuyidi.me

# Optional: ACME / cert notifications for Caddy
CADDY_ACME_EMAIL=ops@example.com

# Email verification / DirectMail
EMAIL_PROVIDER=aliyun_directmail
EMAIL_FROM=Minibot <noreply@mail.liuyidi.me>
EMAIL_SENDER_DOMAIN=mail.liuyidi.me
EMAIL_SENDER_ACCOUNT=noreply
EMAIL_FROM_ALIAS=Minibot
EMAIL_TEMPLATE_LOGIN_CODE=auth_login_code
EMAIL_SERVICE_API_KEY=change-me-access-key-id
EMAIL_SERVICE_SECRET=change-me-access-key-secret
EMAIL_SERVICE_REGION=cn-hangzhou
EMAIL_DEBUG_RETURN_CODE=false
